{
  "$defs": {
    "AdapterReference": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "surface": {
          "enum": [
            "manual",
            "static_dom",
            "prosemirror",
            "lexical",
            "quill",
            "slate",
            "textarea",
            "google_docs"
          ],
          "title": "Surface",
          "type": "string"
        }
      },
      "required": [
        "surface",
        "locator"
      ],
      "title": "AdapterReference",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "adapter_ref": {
          "$ref": "#/$defs/AdapterReference"
        },
        "block_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Block Id",
          "type": "string"
        },
        "end_offset": {
          "exclusiveMinimum": 0,
          "title": "End Offset",
          "type": "integer"
        },
        "normalization": {
          "$ref": "#/$defs/NormalizationMap"
        },
        "original_text": {
          "maxLength": 200000,
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "text_revision": {
          "minimum": 0,
          "title": "Text Revision",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "original_text",
        "start_offset",
        "end_offset",
        "adapter_ref",
        "text_revision",
        "normalization"
      ],
      "title": "Block",
      "type": "object"
    },
    "ExtractionMetadata": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "scope": {
          "enum": [
            "full_document",
            "rendered_content",
            "selection",
            "manual"
          ],
          "title": "Scope",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "surface": {
          "enum": [
            "manual",
            "static_dom",
            "prosemirror",
            "lexical",
            "quill",
            "slate",
            "textarea",
            "google_docs"
          ],
          "title": "Surface",
          "type": "string"
        }
      },
      "required": [
        "surface",
        "scope",
        "adapter_version"
      ],
      "title": "ExtractionMetadata",
      "type": "object"
    },
    "NormalizationMap": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "grapheme_nfkc_casefold_whitespace_v1",
          "title": "Algorithm",
          "type": "string"
        },
        "casefold": {
          "title": "Casefold",
          "type": "boolean"
        },
        "normalized_text": {
          "title": "Normalized Text",
          "type": "string"
        },
        "original_ends": {
          "items": {
            "type": "integer"
          },
          "title": "Original Ends",
          "type": "array"
        },
        "original_starts": {
          "items": {
            "type": "integer"
          },
          "title": "Original Starts",
          "type": "array"
        },
        "original_utf16_length": {
          "minimum": 0,
          "title": "Original Utf16 Length",
          "type": "integer"
        },
        "regex_version": {
          "title": "Regex Version",
          "type": "string"
        },
        "trim": {
          "title": "Trim",
          "type": "boolean"
        },
        "unicode_version": {
          "title": "Unicode Version",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "unicode_version",
        "regex_version",
        "casefold",
        "trim",
        "original_utf16_length",
        "normalized_text",
        "original_starts",
        "original_ends"
      ],
      "title": "NormalizationMap",
      "type": "object"
    }
  },
  "$id": "urn:local-ai-analysis-platform:1.0.0:document.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/Block"
      },
      "maxItems": 2048,
      "minItems": 1,
      "title": "Blocks",
      "type": "array"
    },
    "contract_version": {
      "const": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "document_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Document Id",
      "type": "string"
    },
    "extracted_text": {
      "maxLength": 200000,
      "minLength": 1,
      "title": "Extracted Text",
      "type": "string"
    },
    "extraction_metadata": {
      "$ref": "#/$defs/ExtractionMetadata"
    },
    "language": {
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "title": "Language",
      "type": "string"
    },
    "offset_unit": {
      "const": "utf16_code_unit",
      "title": "Offset Unit",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "contract_version",
    "document_id",
    "revision",
    "language",
    "blocks",
    "extracted_text",
    "offset_unit",
    "extraction_metadata"
  ],
  "title": "Document",
  "type": "object",
  "x-contract-version": "1.0.0"
}
