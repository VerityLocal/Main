{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "urn:local-ai-analysis-platform:1.0.0:event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "diagnostics": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Diagnostics",
      "type": "object"
    },
    "document_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "document_revision": {
      "minimum": 0,
      "title": "Document Revision",
      "type": "integer"
    },
    "offset_unit": {
      "const": "utf16_code_unit",
      "default": "utf16_code_unit",
      "title": "Offset Unit",
      "type": "string"
    },
    "payload": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Payload",
      "type": "object"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "document_id",
    "document_revision",
    "sequence",
    "timestamp"
  ],
  "title": "EventEnvelope",
  "type": "object",
  "x-contract-version": "1.0.0"
}
