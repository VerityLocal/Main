# Generate real, independent secrets with: uv run local-ai-init
# Do not copy these empty credentials into a working configuration.
LOCAL_AI_AUTH_TOKEN=
LOCAL_AI_CSRF_TOKEN=
LOCAL_AI_BIND_HOST=127.0.0.1
LOCAL_AI_PORT=8787
# Add the exact installed extension origin using backend.scripts.pair_extension.
LOCAL_AI_ALLOWED_ORIGINS=[]
LOCAL_AI_MAX_REQUEST_BYTES=1048576
LOCAL_AI_REQUEST_TIMEOUT_SECONDS=15
LOCAL_AI_BODY_TIMEOUT_SECONDS=5
LOCAL_AI_RATE_LIMIT_PER_MINUTE=120
LOCAL_AI_RATE_LIMIT_BURST=30
LOCAL_AI_MAX_CONCURRENT_REQUESTS=8
LOCAL_AI_MAX_DOCUMENTS=128
LOCAL_AI_DOCUMENT_TTL_SECONDS=1800
LOCAL_AI_ANALYSIS_TIMEOUT_SECONDS=180
LOCAL_AI_MAX_ANALYSIS_REQUESTS=32
LOCAL_AI_EVENT_RETENTION_SECONDS=3600
LOCAL_AI_EXTERNAL_SEARCH_ENABLED=false
# Optional absolute paths, preferably outside cloud-synced directories:
# LOCAL_AI_DATA_DIR=C:\Users\YOUR_USER\AppData\Local\VerityLocal\data
# LOCAL_AI_MODEL_CACHE=C:\Users\YOUR_USER\AppData\Local\VerityLocal\models
# LOCAL_AI_DETECTOR_CHECKPOINT=C:\private-models\trained-detector
