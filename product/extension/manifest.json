{
  "manifest_version": 3,
  "name": "Verity — PDF & Website Review",
  "version": "0.2.0",
  "key": "",
  "description": "Review the active PDF or website for source overlap and estimated AI authorship with our in-house detection engine.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:8790/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*", "file:///*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "side_panel": {"default_path": "panel.html"},
  "action": {"default_title": "Review this PDF or website"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:8790 https: http:;"}
}
