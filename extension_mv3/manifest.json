{
  "manifest_version": 3,
  "name": "Verity Local — Private Text Analysis",
  "version": "0.1.0",
  "description": "Analyze selected website surfaces or pasted text using your authenticated local backend.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "panel.html"},
  "action": {"default_title": "Open Verity Local"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
